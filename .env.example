# SANGAM / GovOrchestrator -- Docker Compose configuration.
# Copy to .env and replace EVERY "replace-..." value before the first start.
# Never commit the real .env. (For running the backend directly on the host
# without Compose, see backend/.env.example instead.)

# --- Mode -------------------------------------------------------------------
# development: the SIH demo profile (synthetic sandbox providers + demo seed
#              data allowed).
# production:  refuses to start with demo seeding, sandbox providers, local
#              CORS origins or a weak JWT secret, and hides /docs. Only use it
#              once real, authorized PRODUCTION providers are configured.
SANGAM_ENV=development

# --- PostgreSQL (authoritative state) ----------------------------------------
POSTGRES_DB=sangam_db
POSTGRES_USER=sangam_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# --- Authentication ------------------------------------------------------------
# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_SECONDS=1800

# --- Published ports ------------------------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8001

# --- Frontend -------------------------------------------------------------------
# Leave empty: the frontend container serves the UI and proxies /api to the
# backend on the same origin. Set only if the API lives on another origin.
VITE_API_BASE_URL=
# Origins allowed to call the API cross-origin (the Vite dev server). The
# Compose frontend is same-origin and needs no entry. In production list your
# real HTTPS origin(s) only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# --- Demo data (synthetic only; all must be false in production) ----------------
SANGAM_SEED_CATALOG=true
SANGAM_SEED_DEMO_USERS=true
SANGAM_SEED_SYNTHETIC_DATA=true
SANGAM_SEED_DEPARTMENT_PROVIDERS=true
# Bootstrap passwords for the four named demo accounts (hashed on first start).
SANGAM_CITIZEN_001_PASSWORD=replace-before-first-start
SANGAM_CITIZEN_002_PASSWORD=replace-before-first-start
SANGAM_OFFICER_MH_01_PASSWORD=replace-before-first-start
SANGAM_ADMIN_MH_01_PASSWORD=replace-before-first-start
# Shared password for the persona-diverse synthetic citizen accounts used by
# the demo citizen switcher. Leave blank to skip creating those accounts.
SANGAM_DEMO_CITIZEN_PASSWORD=replace-before-first-start
# Enables the citizen switcher endpoints. Always off when SANGAM_ENV=production.
SANGAM_ALLOW_DEMO_CITIZEN_SWITCH=true
# Only for emergency local debugging: lets the engine fall back to the
# built-in catalog when PostgreSQL has none. Keep false.
SANGAM_ALLOW_DEMO_FALLBACK=false

# --- Department sandbox APIs (synthetic department systems) ---------------------
# Creates and seeds each department's own sandbox database on first start.
DEPARTMENT_SANDBOX_AUTO_SEED=true
# API key for the Transport sandbox providers (auth_type=API_KEY). Compose
# gives the same value to the department-api and to the backend/worker
# adapters. Must be non-empty: SANGAM reports an API-key provider without a
# configured key as MISCONFIGURED and never selects it.
DEPARTMENT_API_KEY_TRANSPORT=replace-with-a-random-demo-key

# --- Redis + async provider jobs -------------------------------------------------
# Redis is non-authoritative (queue/cache/rate limits). With Compose leave
# REDIS_URL unset/default so the internal redis service is used.
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
ASYNC_PROVIDER_JOBS=true
PROVIDER_JOB_RECONCILE_INTERVAL_SECONDS=15
PROVIDER_JOB_RECONCILE_BATCH=25
PROVIDER_JOB_RECONCILE_LEASE_SECONDS=30

# --- Rate limits ---------------------------------------------------------------
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_APPLICATION_CREATE_LIMIT=10
RATE_LIMIT_CONSENT_LIMIT=10
RATE_LIMIT_ADMIN_REPLAY_LIMIT=20
