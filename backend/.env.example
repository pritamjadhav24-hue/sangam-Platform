# Host (non-Docker) development configuration for the backend, worker and
# department sandbox API. Copy to backend/.env; never commit the real file.
# The backend reads this file automatically; real environment variables win.

DATABASE_URL=postgresql+psycopg://postgres:replace-with-your-password@localhost:5432/sangam_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_SECONDS=1800
SANGAM_ENV=development
SANGAM_ALLOW_DEMO_FALLBACK=false

# Synthetic demo data (never enable in production).
SANGAM_SEED_CATALOG=true
SANGAM_SEED_DEMO_USERS=true
SANGAM_SEED_SYNTHETIC_DATA=true
SANGAM_SEED_DEPARTMENT_PROVIDERS=true
SANGAM_CITIZEN_001_PASSWORD=replace-before-first-start
SANGAM_CITIZEN_002_PASSWORD=replace-before-first-start
SANGAM_OFFICER_MH_01_PASSWORD=replace-before-first-start
SANGAM_ADMIN_MH_01_PASSWORD=replace-before-first-start
SANGAM_DEMO_CITIZEN_PASSWORD=replace-before-first-start
SANGAM_ALLOW_DEMO_CITIZEN_SWITCH=true

# Department sandbox API (python -m uvicorn app.department_api.main:app --port 9101).
# SANDBOX_DATA_DIR defaults to backend/data/sandboxes; set it only to relocate the sandbox databases.
DEPARTMENT_SANDBOX_AUTO_SEED=true
DEPARTMENT_API_BASE_URL=http://127.0.0.1:9101
# Transport sandbox providers use API-key auth: SANGAM sends this key and
# reports them MISCONFIGURED without it. Export the same value as
# DEPARTMENT_API_KEY_TRANSPORT for the department API process to enforce it.
PROVIDER_TRANSPORT_SANDBOX_VEHICLE_API_KEY=replace-with-a-random-demo-key
PROVIDER_TRANSPORT_SANDBOX_LICENCE_API_KEY=replace-with-a-random-demo-key

# Redis is optional on the host; provider jobs then stay synchronous.
REDIS_ENABLED=false
ASYNC_PROVIDER_JOBS=false
PROVIDER_JOB_RECONCILE_INTERVAL_SECONDS=15
PROVIDER_JOB_RECONCILE_BATCH=25
PROVIDER_JOB_RECONCILE_LEASE_SECONDS=30

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_APPLICATION_CREATE_LIMIT=10
RATE_LIMIT_CONSENT_LIMIT=10
RATE_LIMIT_ADMIN_REPLAY_LIMIT=20
