DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/sangam_db
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_SECONDS=1800
SANGAM_ENV=development
SANGAM_ALLOW_DEMO_FALLBACK=false
SANGAM_SEED_SYNTHETIC_DATA=false
SANGAM_SEED_DEPARTMENT_PROVIDERS=false
SANDBOX_DATA_DIR=./data/sandboxes
DEPARTMENT_API_BASE_URL=http://localhost:9101
DEPARTMENT_API_KEY_TRANSPORT=
PROVIDER_TRANSPORT_SANDBOX_VEHICLE_API_KEY=
PROVIDER_TRANSPORT_SANDBOX_LICENCE_API_KEY=
PROVIDER_JOB_RECONCILE_INTERVAL_SECONDS=15
PROVIDER_JOB_RECONCILE_BATCH=25
PROVIDER_JOB_RECONCILE_LEASE_SECONDS=30
SANGAM_CITIZEN_001_PASSWORD=change-me-before-first-start
SANGAM_CITIZEN_002_PASSWORD=change-me-before-first-start
SANGAM_OFFICER_MH_01_PASSWORD=change-me-before-first-start
SANGAM_ADMIN_MH_01_PASSWORD=change-me-before-first-start
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_APPLICATION_CREATE_LIMIT=10
RATE_LIMIT_CONSENT_LIMIT=10
RATE_LIMIT_ADMIN_REPLAY_LIMIT=20
