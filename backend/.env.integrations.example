# SANGAM -> department API endpoints (one independent service per department).
# Copy to backend/.env.integrations (loaded by the SANGAM API and worker at
# startup only). Departments without an entry fall back to DEPARTMENT_API_BASE_URL.
DEPARTMENT_API_URL_REVENUE=http://127.0.0.1:9101
DEPARTMENT_API_URL_EDUCATION=http://127.0.0.1:9102
