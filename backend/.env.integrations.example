DEPARTMENT_API_URL_MUNICIPAL_HEALTH=http://127.0.0.1:9104
DEPARTMENT_API_URL_TRANSPORT=http://127.0.0.1:9105
DEPARTMENT_API_URL_AGRICULTURE=http://127.0.0.1:9106
DEPARTMENT_API_URL_LABOUR=http://127.0.0.1:9106
DEPARTMENT_API_URL_FOOD_CIVIL_SUPPLIES=http://127.0.0.1:9106
DEPARTMENT_API_URL_HOUSING=http://127.0.0.1:9106
DEPARTMENT_API_URL_SKILL_EMPLOYMENT=http://127.0.0.1:9106
