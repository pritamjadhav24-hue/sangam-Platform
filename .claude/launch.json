{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sangam-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "sangam-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "sangam-department-api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.department_api.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "9101"],
      "port": 9101
    }
  ]
}
